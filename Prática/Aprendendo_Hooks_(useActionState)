import './app.css';
import { useActionState } from "react"

function App() {

  // 1️⃣ Função que será chamada sempre que o formulário for enviado
  //    - recebe o estado anterior (prevState)
  //    - recebe os dados do form (formData)
  async function handleSubmite(prevState, formData) {

    // Simulação de requisição (espera 2.5s)
    await new Promise((resolve) => setTimeout(() => resolve(), 2500))

    // Captura o valor do input com "name='nome'"
    const nome = formData.get("nome")

    // Apenas para visualizar o que tinha no estado anterior
    console.log(prevState);

    // 2️⃣ Retornando objetos diferentes dependendo da validação
    //    - Se nome < 4 caracteres → inválido
    //    - Senão → mensagem de boas-vindas
    return nome.length < 4
      ? { text: "Nome inválido" }              // estado novo (erro)
      : { text: `Bem vindo ${nome}` }          // estado novo (sucesso)
  }

  // 3️⃣ useActionState:
  //    - 1º parâmetro = função que processa o submit (handleSubmite)
  //    - 2º parâmetro = valor inicial do estado
  //    Ele retorna um array com:
  //      [0] message → estado atual (resultado do handleSubmite)
  //      [1] formAction → função especial que substitui o onSubmit do form
  //      [2] pending → booleano que indica se está aguardando resposta
  const [message, formAction, pending] = useActionState(
    handleSubmite,
    { text: "Se cadastre.." }  // valor inicial
  )

  return (
    <div>
      <h1>useActionState</h1>

      {/* 4️⃣ O form recebe "action={formAction}" 
            → O hook controla o fluxo de envio automaticamente */}
      <form action={formAction}>

        {/* O "name" é importante → formData.get("nome") depende disso */}
        <input
          type="text"
          placeholder="Digite o seu nome"
          name="nome"
          required
        />

        {/* O botão fica desabilitado quando pending = true */}
        <button type="submit" disabled={pending}>
          {pending ? "Cadastrando.." : "Cadastrar"}
        </button>

      </form>

      {/* 5️⃣ Exibição da mensagem retornada pelo estado */}
      {message && <h1>{message.text}</h1>}
    </div>
  )
}

export default App
