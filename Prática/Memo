import { memo } from "react"
import styles from "../../styles/header.module.css"

/*

  - memo é uma função do React que "memoriza" o componente.
  - Ele só re-renderiza quando as PROPS mudam.
  - Isso ajuda a evitar renderizações desnecessárias.

  Bom usar quando:
    - O componente é "puro" (depende só das props)
    - Componentes em listas grandes (map)
    - Não tem estado interno ou lógica pesada de hooks

Exemplo de comparação customizada:
    const MeuComponente = memo(
      (props) => { ... },
      (prevProps, nextProps) => prevProps.name === nextProps.name
    )
*/

export const Header = memo(({ name }) => {
  console.log("Renderizando") // só aparece se a prop 'name' mudar

  return (
    <h3 className={styles.header}>Bem vindo {name}</h3>
  )
})
